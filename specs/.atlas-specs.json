 "taxonomy": {
  "domains": [
   {
    "areas": [
     {
      "description": "Describes a cron expression's minutes, hours, days, months and weekdays as readable English.",
      "slug": "plain-language",
      "title": "Plain-language descriptions"
     },
     {
      "description": "Expands shortcuts such as @daily, @hourly and @weekly into full schedules before describing them.",
      "slug": "macros",
      "title": "Shorthand macros"
     },
     {
      "description": "Handles expressions with a seconds field (first or last) and weekday numbering that starts at 0 or 1.",
      "slug": "seconds-and-weekday-numbering",
      "title": "Seconds fields and weekday numbering"
     },
     {
      "description": "Translates English phrases like \"every 15 minutes\" or \"last day of the month\" into cron expressions.",
      "slug": "phrase-to-cron",
      "title": "Phrase to cron"
     },
     {
      "description": "Explains when a requested interval (e.g. every 7 days, every 90 minutes) can't be expressed exactly in cron, and gives the closest alternatives.",
      "slug": "beyond-cron",
      "title": "Schedules cron cannot express"
     }
    ],
    "description": "Turning a schedule into plain language, and plain-language phrases back into schedules.",
    "slug": "schedule-explanation",
